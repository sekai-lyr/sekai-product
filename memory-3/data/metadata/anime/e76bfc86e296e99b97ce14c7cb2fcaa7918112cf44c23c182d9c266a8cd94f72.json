Apw.jpg","large":"https://lain.bgm.tv/pic/cover/l/c8/aa/152083_V4Apw.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/c8/aa/152083_V4Apw.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/c8/aa/152083_V4Apw.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/c8/aa/152083_V4Apw.jpg","summary":"　　刺猬求小猪帮忙摘除身上的红果、小熊要求进小猪房中避雨时，小猪均以“我不帮助别人，也不要别人帮助”为理由拒绝了，甚至小白兔被大灰狼紧追要求进它院子里躲避一下时，它也不肯伸手相助，它的自私行为惹得篱笆、大树和小屋都很不满。 \r\n　　捉兔不成的大灰狼向小猪叫嚣时，小猪以为它根本闯不破坚固的篱笆，不想篱笆自动离它而去，随后，小屋和大树也不肯帮助它，小猪落入大灰狼手中。路上，小猪奋力逃脱，幸好有一块独木舟才免于落入湖中，不想因为又念叨“我不要别人帮助”，它再落大灰狼之手，这时，太阳公公也对它摇起头。孤独的小猪以为性命难保之时，曾被它拒绝帮助的小白兔找来小熊和刺猬商议，大伙决定把它从大灰狼的魔爪中救出来。","name":"孤独的小猪","name_cn":"","tags":[{"name":"短片","count":3,"total_count":94286},{"name":"中国","count":3,"total_count":27251},{"name":"1988","count":2,"total_count":6404},{"name":"动画","count":2,"total_count":32940},{"name":"国产","count":2,"total_count":153192},{"name":"沈祖慰","count":2,"total_count":32},{"name":"凌纾","count":2,"total_count":34},{"name":"子供向","count":1,"total_count":10858},{"name":"定格动画","count":1,"total_count":2951},{"name":"中国动画","count":1,"total_count":2037},{"name":"上海美术电影制片厂","count":1,"total_count":10214},{"name":"剪纸","count":1,"total_count":159},{"name":"上美","count":1,"total_count":629},{"name":"YL","count":1,"total_count":143},{"name":"剧场版","count":1,"total_count":680026}],"infobox":[{"key":"上映年度","value":"1988年"},{"key":"片长","value":"10分钟"},{"key":"制片国家/地区","value":"中国大陆"},{"key":"导演","value":"沈祖慰"},{"key":"话数","value":"1"}],"rating":{"rank":0,"total":6,"count":{"1":0,"2":0,"3":0,"4":0,"5":1,"6":3,"7":2,"8":0,"9":0,"10":0},"score":6.2},"collection":{"on_hold":1,"dropped":5,"wish":1,"collect":15,"doing":1},"id":152083,"eps":1,"total_episodes":1,"meta_tags":["剧场版","中国"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2},{"date":null,"platform":"剧场版","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/2a/d6/173243_lfLaw.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/2a/d6/173243_lfLaw.jpg","large":"https://lain.bgm.tv/pic/cover/l/2a/d6/173243_lfLaw.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/2a/d6/173243_lfLaw.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/2a/d6/173243_lfLaw.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/2a/d6/173243_lfLaw.jpg","summary":"　　小鸟随它的伙伴离去之后，蜡烛又成为孤独的莉里的唯一伙伴，在忽明忽暗的烛光中，莉里进入了遐想中的世界，结识和她同名、且也失去妈妈的、没谁陪着玩的小王子，两人很快成为无话不谈的朋友。 \r\n　　国王带着大臣打猎的日子，小王子为躲开吵嚷的众人，单独骑着大蚂蚱去给莉里打野猪，不想遇到两个身形异常庞大、相貌十分丑陋的老妖婆，娇小可爱的他被她们囚禁在了一张床上。莉里千辛万苦找到小王子，并凭着机智将他救出。可是即使在梦里，小王子也只是她短暂的好玩伴。","name":"孤独的莉里","name_cn":"","tags":[{"name":"中国","count":4,"total_count":31954},{"name":"短片","count":4,"total_count":102670},{"name":"国产","count":3,"total_count":161640},{"name":"方润南","count":3,"total_count":14},{"name":"薛梅君","count":3,"total_count":9},{"name":"1990","count":3,"total_count":2800},{"name":"原创","count":2,"total_count":623124},{"name":"余又晨","count":2,"total_count":8},{"name":"剧场版","count":2,"total_count":727324},{"name":"动画","count":1,"total_count":35779},{"name":"南方","count":1,"total_count":1},{"name":"子供向","count":1,"total_count":13095},{"name":"上海美术电影制片厂","count":1,"total_count":10630},{"name":"上美","count":1,"total_count":649}],"infobox":[{"key":"上映年度","value":"1990年"},{"key":"片长","value":"20分钟"},{"key":"导演","value":"方润南、薛梅君"},{"key":"脚本","value":"余又晨、南方"},{"key":"话数","value":"1"}],"rating":{"rank":0,"total":6,"count":{"1":1,"2":1,"3":1,"4":0,"5":0,"6":2,"7":0,"8":1,"9":0,"10":0},"score":4.3},"collection":{"on_hold":1,"dropped":7,"wish":3,"collect":12,"doing":1},"id":173243,"eps":1,"total_episodes":1,"meta_tags":["剧场版","中国"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2},{"date":"2017-11-29","platform":"WEB","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/dd/69/216228_gx9oK.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/dd/69/216228_gx9oK.jpg","large":"https://lain.bgm.tv/pic/cover/l/dd/69/216228_gx9oK.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/dd/69/216228_gx9oK.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/dd/69/216228_gx9oK.jpg"},"image":"https:/