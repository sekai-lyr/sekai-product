受け、早速動き出す小林とミルキィホームズ。\r\nすると、他にもジョンの描いた絵画がロンドン市内で2点も盗まれていることが判明する。無名画家の絵画が、なぜ3点も盗難に。単なる絵画盗難事件ではないという危惧を感じた小林は、ミルキィホームズたちと他の被害者宅を訪れるが･･･。","name":"探偵オペラ ミルキィホームズ Alternative ONE～小林オペラと5枚の絵画～","name_cn":"侦探歌剧 少女福尔摩斯 Alternative ONE","tags":[{"name":"OVA","count":102,"total_count":372057},{"name":"J.C.STAFF","count":85,"total_count":139186},{"name":"侦探歌剧","count":57,"total_count":627},{"name":"2012","count":55,"total_count":56710},{"name":"游戏改","count":43,"total_count":166353},{"name":"搞笑","count":29,"total_count":657774},{"name":"2012年8月","count":25,"total_count":700},{"name":"百合","count":24,"total_count":414132},{"name":"TV","count":23,"total_count":1445254},{"name":"ArtLand","count":18,"total_count":3337},{"name":"中原麻衣","count":17,"total_count":2902},{"name":"四萝莉","count":15,"total_count":15},{"name":"阿澄佳奈","count":11,"total_count":4714},{"name":"原创","count":11,"total_count":636453},{"name":"三森すずこ","count":9,"total_count":602},{"name":"推理","count":9,"total_count":75516},{"name":"萝莉","count":9,"total_count":47166},{"name":"岩崎良明","count":9,"total_count":689},{"name":"日本","count":6,"total_count":314405},{"name":"2012年","count":4,"total_count":3331},{"name":"ALTERNATIVE","count":4,"total_count":9},{"name":"TVSP","count":3,"total_count":2002},{"name":"橘田いずみ","count":2,"total_count":35},{"name":"这还可以","count":2,"total_count":2},{"name":"徳井青空","count":2,"total_count":108},{"name":"Bushiroad","count":2,"total_count":891},{"name":"伊神貴世","count":2,"total_count":62},{"name":"TVA","count":2,"total_count":16349},{"name":"萌豚","count":2,"total_count":8077},{"name":"补番","count":2,"total_count":10575}],"infobox":[{"key":"中文名","value":"侦探歌剧 少女福尔摩斯 Alternative ONE"},{"key":"别名","value":[{"v":"侦探歌剧 Alternative ONE"}]},{"key":"话数","value":"1"},{"key":"放送开始","value":"2012年8月25日"},{"key":"官方网站","value":"http://milky-holmes-anime.com/news/alternative_one.html"}],"rating":{"rank":5645,"total":311,"count":{"1":2,"2":2,"3":4,"4":9,"5":38,"6":109,"7":106,"8":34,"9":2,"10":5},"score":6.4},"coll