リーズ初期の佳作である。","name":"世界名作劇場・完結版 ペリーヌ物語","name_cn":"世界名作剧场·完结版 佩琳物语","tags":[{"name":"日本アニメーション","count":1,"total_count":939},{"name":"小说改","count":1,"total_count":163171},{"name":"2001","count":1,"total_count":15815},{"name":"日本","count":1,"total_count":304588},{"name":"TV","count":1,"total_count":1422454}],"infobox":[{"key":"中文名","value":"世界名作剧场·完结版 佩琳物语"},{"key":"别名","value":[{"v":"ペリーヌ物語 完結版"},{"v":"世界名作剧场·完结版 小英的故事"},{"v":"Sekai Meisaku Gekijou Kanketsu Ban: Perrine Monogatari"},{"v":"World Masterpiece Theater Complete Edition: Perrine de \"En Famille\""}]},{"key":"话数","value":"2"},{"key":"放送开始","value":"2001年1月28日"},{"key":"制作","value":"BSフジ、日本アニメーション"}],"rating":{"rank":0,"total":3,"count":{"1":0,"2":0,"3":0,"4":0,"5":1,"6":1,"7":1,"8":0,"9":0,"10":0},"score":6},"collection":{"on_hold":3,"dropped":4,"wish":7,"collect":5,"doing":2},"id":316372,"eps":2,"total_episodes":2,"meta_tags":["TV","日本","小说改"],"volumes":0,"series":false,"locked":false,"nsfw":false,"type":2},{"date":"2001-04-14","platform":"TV","images":{"small":"https://lain.bgm.tv/r/200/pic/cover/l/51/46/316376_9C2s7.jpg","grid":"https://lain.bgm.tv/r/100/pic/cover/l/51/46/316376_9C2s7.jpg","large":"https://lain.bgm.tv/pic/cover/l/51/46/316376_9C2s7.jpg","medium":"https://lain.bgm.tv/r/800/pic/cover/l/51/46/316376_9C2s7.jpg","common":"https://lain.bgm.tv/r/400/pic/cover/l/51/46/316376_9C2s7.jpg"},"image":"https://lain.bgm.tv/pic/cover/l/51/46/316376_9C2s7.jpg","summary":"","name":"世界名作劇場・完結版 牧場の少女カトリ","name_cn":"世界名作剧场·完结版 牧场上的少女卡特莉","tags":[{"name":"TV","count":2,"total_count":1426801},{"name":"小说改","count":2,"total_count":164094},{"name":"日本","count":2,"total_count":305601},{"name":"日本アニメーション","count":1,"total_count":939},{"name":"2001","count":1,"total_count":15840},{"name":"搞笑","count":1,"total_count":649238},{"name":"后宫","count":1,"total_count":307903}],"infobox":[{"key":"中文名","value":"世界名作剧场·完结版 牧场上的少女卡特莉"},{"key":"别名","value":[{"v":"Sekai Meisaku Gekijou Kanketsu Ban: Makiba no Shoujo Katri"}]},{