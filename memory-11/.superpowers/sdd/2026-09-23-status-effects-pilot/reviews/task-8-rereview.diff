+    e.eventBus.on("onCoinFlip", data => coins.push(data.result));
+    themedEffectHandlers.themedAction({ engine: e, player: p, opponent: o, card: p, effect: { action: "gamble", params: { draw: 2, heal: 800 }, skillName: "t" }, gameState: s });
