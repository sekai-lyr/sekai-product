<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.draw.lots.mapper.SekaiDrawLotsWheelSpinMapper">
    <resultMap id="BaseResultMap" type="com.sekai.draw.lots.dataobject.SekaiDrawLotsWheelSpinDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/><result property="deckId" column="deck_id"/>
        <result property="optionId" column="option_id"/>
        <result property="resultTitle" column="result_title"/>
        <result property="resultDetail" column="result_detail"/>
        <result property="resultColor" column="result_color"/>
        <result property="moodLine" column="mood_line"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="BaseColumns">
        id, user_id, deck_id, option_id, result_title, result_detail, result_color, mood_line, create_time
    </sql>

    <insert id="insert" parameterType="com.sekai.draw.lots.dataobject.SekaiDrawLotsWheelSpinDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_Draw_lots_wheel_spin
        (user_id, deck_id, option_id, result_title, result_detail, result_color, mood_line)
        VALUES
        (#{userId}, #{deckId}, #{optionId}, #{resultTitle}, #{resultDetail}, #{resultColor}, #{moodLine})
    </insert>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sekai_Draw_lots_wheel_spin
        WHERE id = #{id}
    </select>

    <select id="selectRecentByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sekai_Draw_lots_wheel_spin
        WHERE user_id = #{userId} AND deck_id = #{deckId}
        ORDER BY create_time DESC, id DESC
        LIMIT #{limit}
    </select>
</mapper>
