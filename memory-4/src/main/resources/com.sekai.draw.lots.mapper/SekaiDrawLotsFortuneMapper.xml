<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.draw.lots.mapper.SekaiDrawLotsFortuneMapper">
    <resultMap id="BaseResultMap" type="com.sekai.draw.lots.dataobject.SekaiDrawLotsFortuneDO">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="levelName" column="level_name"/>
        <result property="luckScore" column="luck_score"/>
        <result property="advice" column="advice"/>
        <result property="luckyColor" column="lucky_color"/>
        <result property="luckyItem" column="lucky_item"/>
    </resultMap>

    <select id="selectRandom" resultMap="BaseResultMap">
        SELECT id, summary AS title, level_name, FLOOR((score_min + score_max) / 2) AS luck_score,
               advice, lucky_color, lucky_item
        FROM sekai_Draw_lots_fortune
        ORDER BY RAND()
        LIMIT 1
    </select>
</mapper>
