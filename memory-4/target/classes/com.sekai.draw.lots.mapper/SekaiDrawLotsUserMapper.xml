<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.draw.lots.mapper.SekaiDrawLotsUserMapper">
    <resultMap id="BaseResultMap" type="com.sekai.draw.lots.dataobject.SekaiDrawLotsUserDO">
        <id property="id" column="id"/>
        <result property="userName" column="username"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="BaseColumns">id, username, password, nickname, avatar, create_time</sql>

    <insert id="insert" parameterType="com.sekai.draw.lots.dataobject.SekaiDrawLotsUserDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_Draw_lots_user (username, password, nickname, avatar)
        VALUES (#{userName}, #{password}, #{nickName}, #{avatar})
    </insert>

    <select id="selectByPrimaryKey" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_Draw_lots_user WHERE id = #{id}
    </select>

    <select id="selectByUserName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_Draw_lots_user WHERE username = #{userName}
    </select>

    <select id="selectByLoginName" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sekai_Draw_lots_user
        WHERE username = #{loginName} OR nickname = #{loginName}
        ORDER BY CASE WHEN username = #{loginName} THEN 0 ELSE 1 END, id
        LIMIT 1
    </select>

    <update id="updateByPrimaryKeySelective" parameterType="com.sekai.draw.lots.dataobject.SekaiDrawLotsUserDO">
        UPDATE sekai_Draw_lots_user
        <set>
            <if test="userName != null">username = #{userName},</if>
            <if test="password != null">password = #{password},</if>
            <if test="nickName != null">nickname = #{nickName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
