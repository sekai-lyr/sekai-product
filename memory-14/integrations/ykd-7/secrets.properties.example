# ==========================================
# API keys template
# ==========================================
# Copy to secrets.properties and fill in real keys

# DeepSeek AI (routing + text chat)
# https://platform.deepseek.com/api_keys
deepseek.api.key=your_key_here

# DashScope API key (Alibaba Cloud)
# Used for: image/video generation, vision/OCR, ASR and TTS
# Get from: https://dashscope.console.aliyun.com/apiKey
dashscope.api.key=your_dashscope_key_here

# PostgreSQL JPA profile (activate with SPRING_PROFILES_ACTIVE=postgres)
postgres.url=jdbc:postgresql://localhost:5432/openclaw
postgres.username=openclaw
postgres.password=change_me

# Optional HTTP proxy used by web search and page access, for example Clash/V2Ray on Windows
# web.proxy-url=http://127.0.0.1:7890

# AMap Web Service API
# https://console.amap.com/dev/key/app
amap.api.key=your_amap_web_service_key_here

# FlyAI / Fliggy travel product search (optional trial works without a key)
# Install first: npm i -g @fly-ai/flyai-cli
flyai.api-key=your_flyai_key_here
