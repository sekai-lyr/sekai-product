<mapper namespace="com.sekai.dataobject.mapper.SekaiDataObjectCharacterMapper">

    <resultMap id="BaseResultMap" type="com.sekai.dataobject.dataobject.SekaiDataObjectCharacterDO">
        <id property="id" column="id"/>
        <result property="seriesId" column="series_id"/>
        <result property="name" column="name"/>
        <result property="originalName" column="original_name"/>
        <result property="role" column="role"/>
        <result property="voiceActor" column="voice_actor"/>
        <result property="description" column="description"/>
        <result property="imageUrl" column="image_url"/>
        <result property="createTime" column="create_time"/>
