                OR original_name LIKE CONCAT('%', #{keyword}, '%')
                OR voice_actor LIKE CONCAT('%', #{keyword}, '%')
                OR role LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="seriesId != null">
