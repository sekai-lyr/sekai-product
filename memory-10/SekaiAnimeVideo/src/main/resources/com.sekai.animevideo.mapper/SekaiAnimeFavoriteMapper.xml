<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.animevideo.mapper.SekaiAnimeFavoriteMapper">
    <resultMap id="BaseResultMap" type="com.sekai.animevideo.dataobject.SekaiAnimeFavoriteDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="siteId" column="site_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="Base_Column_List">id, user_id, site_id, create_time</sql>
    <insert id="insert" parameterType="com.sekai.animevideo.dataobject.SekaiAnimeFavoriteDO" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sekai_anime_mode_favorite (user_id, site_id) VALUES (#{userId}, #{siteId})
    </insert>
    <delete id="deleteByUserAndSite">
        DELETE FROM sekai_anime_mode_favorite WHERE user_id = #{userId} AND site_id = #{siteId}
    </delete>
    <select id="countByUserId" resultType="int">
        SELECT COUNT(1) FROM sekai_anime_mode_favorite WHERE user_id = #{userId}
    </select>
    <select id="existsByUserAndSite" resultType="boolean">
        SELECT COUNT(1) > 0 FROM sekai_anime_mode_favorite WHERE user_id = #{userId} AND site_id = #{siteId}
    </select>
    <select id="listByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/> FROM sekai_anime_mode_favorite WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>
</mapper>
