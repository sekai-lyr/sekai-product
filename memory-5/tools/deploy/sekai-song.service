[Unit]
Description=Sekai Song Player
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=sekai
Group=sekai
WorkingDirectory=/opt/sekai-song
EnvironmentFile=/etc/sekai-song/environment
ExecStart=/usr/bin/java -Xms128m -Xmx640m -XX:MaxMetaspaceSize=192m -Dsekai.externalUploadRoot=/opt/sekai-song/external-uploads -jar /opt/sekai-song/app.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/sekai-song/ --server.address=127.0.0.1
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
