<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sekai.draw.lots.mapper.SekaiDrawLotsFortuneMapper">

    <resultMap id="BaseResultMap" type="com.sekai.draw.lots.dataobject.SekaiDrawLotsFortuneDO">
        <id property="id" column="id"/>
        <result property="levelName" column="level_name"/>
        <result property="scoreMin" column="score_min"/>
        <result property="scoreMax" column="score_max"/>
        <result property="luckyColor" column="lucky_color"/>
        <result property="luckyItem" column="lucky_item"/>
        <result property="summary" column="summary"/>
        <result property="advice" column="advice"/>
    </resultMap>

    <select id="selectByScore" resultMap="BaseResultMap">
        SELECT id, level_name, score_min, score_max, lucky_color, lucky_item, summary, advice
        FROM sekai_draw_lots_fortune
        WHERE #{score} BETWEEN score_min AND score_max
        ORDER BY score_min DESC
        LIMIT 1
    </select>
</mapper>
