<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.galagame.mapper.SekaiGalagameCharacterMapper">
    <resultMap id="BaseResultMap" type="com.sekai.galagame.dataobject.SekaiGalagameCharacterDO">
        <id property="charKey" column="char_key"/>
        <result property="name" column="name"/>
        <result property="color" column="color"/>
        <result property="role" column="role"/>
        <result property="sortNo" column="sort_no"/>
    </resultMap>
    <sql id="BaseColumns">char_key, name, color, role, sort_no</sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_GaLaGame_lies_characters ORDER BY sort_no
    </select>
</mapper>
