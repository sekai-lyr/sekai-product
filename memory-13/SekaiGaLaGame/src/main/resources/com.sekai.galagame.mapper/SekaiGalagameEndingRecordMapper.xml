<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.galagame.mapper.SekaiGalagameEndingRecordMapper">
    <resultMap id="BaseResultMap" type="com.sekai.galagame.dataobject.SekaiGalagameEndingRecordDO">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="endingKey" column="ending_key"/>
        <result property="unlockTime" column="unlock_time"/>
    </resultMap>
    <sql id="BaseColumns">id, user_id, ending_key, unlock_time</sql>

    <insert id="insertIgnore" parameterType="com.sekai.galagame.dataobject.SekaiGalagameEndingRecordDO">
        INSERT IGNORE INTO sekai_GaLaGame_lies_ending_records (user_id, ending_key)
        VALUES (#{userId}, #{endingKey})
    </insert>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_GaLaGame_lies_ending_records
        WHERE user_id = #{userId}
        ORDER BY unlock_time DESC
    </select>
</mapper>
