<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sekai.galagame.mapper.SekaiGalagameChapterMapper">
    <resultMap id="BaseResultMap" type="com.sekai.galagame.dataobject.SekaiGalagameChapterDO">
        <id property="chapterNo" column="chapter_no"/>
        <result property="title" column="title"/>
        <result property="startLabel" column="start_label"/>
        <result property="summary" column="summary"/>
        <result property="sortNo" column="sort_no"/>
    </resultMap>
    <sql id="BaseColumns">chapter_no, title, start_label, summary, sort_no</sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_GaLaGame_lies_chapters ORDER BY sort_no
    </select>

    <select id="selectByChapterNo" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/> FROM sekai_GaLaGame_lies_chapters WHERE chapter_no = #{chapterNo}
    </select>
</mapper>
